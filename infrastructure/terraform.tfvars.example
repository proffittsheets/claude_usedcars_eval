# Copy this file to terraform.tfvars (gitignored) and fill in your values.

aws_region  = "us-east-1"
aws_profile = "default"                        # name of your local AWS CLI profile
bucket_name = "your-globally-unique-bucket"    # must be globally unique across all AWS accounts

# Optional — default is PriceClass_100 (US + Europe, cheapest)
# price_class = "PriceClass_100"
